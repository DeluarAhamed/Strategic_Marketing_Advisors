{
  "name": "strategic-marketing-advisors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:migrate": "node scripts/migrate-content.mjs",
    "content:expand": "node scripts/expand-articles.mjs",
    "sanity:seed": "node scripts/export-sanity-seed.mjs",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:import": "npm run sanity:seed && sanity dataset import sanity/seed/production.ndjson production --replace",
    "studio:build": "sanity build studio --yes && node scripts/fix-studio-build.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "npm run build && npm run check && npm run check:seo && node --test tests/backend.test.mjs",
    "dev": "npx serve . -l 3000"
  },
  "dependencies": {
    "@sanity/client": "^7.11.1",
    "@sanity/vision": "^4.6.0",
    "cheerio": "^1.1.0",
    "sanity": "^4.6.0",
    "styled-components": "^6.1.19"
  }
}
