{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run check && npm run check:seo && npm run studio:build && node scripts/package-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/studio/:path*",
      "destination": "/studio"
    },
    {
      "source": "/",
      "destination": "/api/render?route=/"
    },
    {
      "source": "/services",
      "destination": "/api/render?route=/services"
    },
    {
      "source": "/services/:path*",
      "destination": "/api/render?route=/services/:path*"
    },
    {
      "source": "/about",
      "destination": "/api/render?route=/about"
    },
    {
      "source": "/about/:path*",
      "destination": "/api/render?route=/about/:path*"
    },
    {
      "source": "/resources",
      "destination": "/api/render?route=/resources"
    },
    {
      "source": "/resources/:path*",
      "destination": "/api/render?route=/resources/:path*"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/render?route=/articles/:slug"
    },
    {
      "source": "/demo",
      "destination": "/api/render?route=/demo"
    },
    {
      "source": "/contact",
      "destination": "/api/render?route=/contact"
    },
    {
      "source": "/blog",
      "destination": "/api/render?route=/blog"
    },
    {
      "source": "/privacy",
      "destination": "/api/render?route=/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/render?route=/terms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/render?route=/sitemap.xml"
    },
    {
      "source": "/admin",
      "destination": "/dashboard"
    },
    {
      "source": "/admin/:path*",
      "destination": "/dashboard"
    }
  ],
  "headers": [
    {
      "source": "/(admin|studio|static)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://bqifzwpdgwkjfphkrjgl.supabase.co; connect-src 'self' https://bqifzwpdgwkjfphkrjgl.supabase.co; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://bqifzwpdgwkjfphkrjgl.supabase.co; connect-src 'self' https://bqifzwpdgwkjfphkrjgl.supabase.co; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
