{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run check && npm run check:seo && npm run studio:build && node scripts/package-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/studio/:path*",
      "destination": "/studio"
    }
  ],
  "headers": [
    {
      "source": "/(admin|studio|static)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/google-ads",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/logo-brand-kit",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/web-design",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/reputation-management",
      "destination": "/services/ai-visibility",
      "permanent": true
    },
    {
      "source": "/services/gbp-audit",
      "destination": "/services/ai-visibility",
      "permanent": true
    },
    {
      "source": "/services/seo-local",
      "destination": "/services/ai-visibility",
      "permanent": true
    },
    {
      "source": "/services/ai-automation",
      "destination": "/services/vedakosa",
      "permanent": true
    },
    {
      "source": "/services/executive-consulting",
      "destination": "/services/vedakosa",
      "permanent": true
    }
  ]
}
